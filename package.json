{
  "name": "@edlontech/pi-token-optimizer",
  "version": "0.1.0",
  "description": "Local Token Optimizer integration for Pi",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "token-optimizer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edlontech/pi-token-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/edlontech/pi-token-optimizer/issues"
  },
  "homepage": "https://github.com/edlontech/pi-token-optimizer#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions/*.ts",
    "src/*.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "PRIVACY.md",
    "docs/*.md",
    "python/*.py",
    "patches/*.patch",
    "vendor/manifest.json",
    "vendor/token-optimizer/LICENSE",
    "vendor/token-optimizer/PRIVACY.md",
    "vendor/token-optimizer/hooks/python-launcher.sh",
    "vendor/token-optimizer/skills/token-optimizer/assets/dashboard.html",
    "vendor/token-optimizer/skills/token-optimizer/scripts/**/*.py",
    "vendor/token-optimizer/skills/token-optimizer/scripts/*.js"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "lint": "oxlint --deny-warnings extensions src tests",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:python": "PYTHONDONTWRITEBYTECODE=1 python3 -c 'import sys, unittest; result = unittest.TextTestRunner().run(unittest.defaultTestLoader.discover(\"tests/python\")); sys.exit(not result.wasSuccessful())'",
    "benchmark": "node --import tsx scripts/benchmark.mjs",
    "vendor:check": "node scripts/check-vendor.mjs",
    "vendor:sync": "node scripts/sync-upstream.mjs",
    "package:check": "tsx --test --test-name-pattern='package tarball|capability rows' tests/vendor.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:python && npm run test:integration && npm run vendor:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "26.4.1",
    "oxlint": "1.81.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
